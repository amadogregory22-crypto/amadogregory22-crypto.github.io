{
  "entities": {
    "project": {
      "title": "Projet de Signature",
      "description": "Stocke l'état complet du studio de signature",
      "type": "object",
      "properties": {
        "userId": { "type": "string", "description": "UID de l'utilisateur" },
        "name": { "type": "string", "description": "Nom du projet" },
        "state": { "type": "object", "description": "État JSON complet du projet" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "state", "updatedAt"]
    }
  },
  "firestore": {
    "/projects/{projectId}": {
      "schema": "project",
      "description": "Collection des projets de signature"
    }
  }
}
