# Server
PORT=3001
HOST=0.0.0.0
NODE_ENV=development

# CORS
CORS_ORIGIN=http://localhost:5173

# Database
DB_TYPE=sqlite
DB_PATH=./data/ragt-studio.db

# Authentication (prepared for SSO)
AUTH_MODE=mock
AUTH_OIDC_ISSUER=
AUTH_OIDC_CLIENT_ID=
AUTH_OIDC_CLIENT_SECRET=

# AI Configuration
AI_ENABLED=false
AI_PROVIDER=ollama
OLLAMA_URL=http://localhost:11434
OPENAI_COMPATIBLE_URL=
OPENAI_COMPATIBLE_KEY=

# Connectors
MS_GRAPH_CLIENT_ID=
MS_GRAPH_CLIENT_SECRET=
MS_GRAPH_TENANT_ID=
GLPI_URL=
GLPI_API_TOKEN=
LDAP_URL=
LDAP_BASE_DN=

# Storage
STORAGE_PATH=./data/storage
MAX_FILE_SIZE_MB=50

# Logging
LOG_LEVEL=info
LOG_FORMAT=json

# Security
SESSION_SECRET=change-me-in-production
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
